rules_version = '2';

// Reglas de seguridad de Luz y Aroma.
// Esconder botones en la interfaz NO es seguridad: estas reglas son las que
// realmente impiden que un cliente haga operaciones de administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function esAdmin() {
      return logueado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ---------- usuarios ----------
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());

      // Al registrarse, cada quien crea SOLO su propio perfil y SOLO como cliente.
      allow create: if logueado()
        && request.auth.uid == uid
        && request.resource.data.rol == 'cliente';

      // Puede editar su perfil, pero nunca cambiar su rol.
      allow update: if logueado()
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol;

      allow delete: if esAdmin();
    }

    // ---------- productos (velas) ----------
    match /productos/{id} {
      // El catálogo es público.
      allow read: if true;

      allow create, delete: if esAdmin();

      // El admin edita todo. Un cliente solo puede BAJAR el stock (al comprar),
      // sin tocar ningún otro campo y sin dejarlo negativo.
      allow update: if esAdmin() || (
        logueado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.stock >= 0
      );
    }

    // ---------- pedidos ----------
    match /pedidos/{id} {
      // Cada cliente ve solo sus pedidos; el admin ve todos.
      allow read: if logueado()
        && (resource.data.clienteId == request.auth.uid || esAdmin());

      // Un cliente solo crea pedidos a su nombre, en estado pendiente y con artículos.
      allow create: if logueado()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.items.size() > 0
        && request.resource.data.total > 0;

      // Solo el admin cambia estados o elimina pedidos.
      allow update, delete: if esAdmin();
    }
  }
}
